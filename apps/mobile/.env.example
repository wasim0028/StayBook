# Copy to .env.local. EXPO_PUBLIC_* values are compiled into the app bundle; never put secrets here.
EXPO_PUBLIC_API_URL=https://api.dev.example.in
EXPO_PUBLIC_COGNITO_REGION=ap-south-1
EXPO_PUBLIC_COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
EXPO_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Web app, opened for listing editing (photos, map pin, calendar)
EXPO_PUBLIC_WEB_URL=https://dev.example.in
EXPO_PUBLIC_COGNITO_DOMAIN=https://marketplace-dev-yourorg.auth.ap-south-1.amazoncognito.com

# Build-time only (read by app.config.ts)
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=

# Build-time: EAS project id, needed for push notifications (run `eas init`)
EAS_PROJECT_ID=
